# Database Configuration
database:
  host: localhost
  port: 5432
  name: interest_rates_db
  user: postgres  # Change to your PostgreSQL username
  password:   # Add password if needed

# API Keys and Configuration
apis:
  fred:
    api_key: YOUR_FRED_API_KEY_HERE  # Get from https://fred.stlouisfed.org/docs/api/api_key.html
    base_url: https://api.stlouisfed.org/fred
  
  treasury:
    base_url: https://home.treasury.gov/resource-center/data-chart-center/interest-rates
  
  cftc:
    base_url: https://publicreporting.cftc.gov/resource

# Data Collection Settings
collection:
  backfill_years: 10
  retry_attempts: 3
  retry_delay: 5  # seconds
  
# FRED Series IDs for data collection
fred_series:
  # Treasury Rates
  treasury_rates:
    DGS1MO: "1-Month"
    DGS3MO: "3-Month"
    DGS6MO: "6-Month"
    DGS1: "1-Year"
    DGS2: "2-Year"
    DGS5: "5-Year"
    DGS7: "7-Year"
    DGS10: "10-Year"
    DGS20: "20-Year"
    DGS30: "30-Year"
  
  # Policy Rates
  policy_rates:
    DFF: "Federal Funds Effective Rate"
    SOFR: "Secured Overnight Financing Rate"
    EFFR: "Effective Federal Funds Rate"
    OBFR: "Overnight Bank Funding Rate"
  
  # Economic Indicators
  economic_indicators:
    CPIAUCSL: "Consumer Price Index"
    UNRATE: "Unemployment Rate"
    GDP: "Gross Domestic Product"
    FEDFUNDS: "Federal Funds Target Rate"
    T10Y2Y: "10-Year Treasury Constant Maturity Minus 2-Year"
    T10Y3M: "10-Year Treasury Constant Maturity Minus 3-Month"

# Logging
logging:
  level: INFO
  format: "<green>{time:YYYY-MM-DD HH:mm:ss}</green> | <level>{level: <8}</level> | <cyan>{name}</cyan>:<cyan>{function}</cyan> - <level>{message}</level>"
  log_file: logs/data_collection.log

